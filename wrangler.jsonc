{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "acfb-email",
  "main": "server/index.ts",
  "compatibility_date": "2026-08-27",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "SYNC_QUEUE",
        "queue": "email-sync",
      },
    ],
    "consumers": [
      {
        "queue": "email-sync",
        "max_batch_size": 1,
        "max_retries": 1,
        "retry_delay": 60,
      },
    ],
  },
  "triggers": {
    // Background new-mail discovery: the scheduled handler enqueues an inbox
    // check for every account that is due. Cadence is fixed at deploy time;
    // the browser's own auto-check cadence is a frontend preference.
    "crons": ["*/5 * * * *"],
  },
  "vars": {
    "SYNC_FETCH_LIMIT": "100",
    "SYNC_TIMEOUT_MS": "480000",
    "PRODUCTION_DEBUG": "false",
  },
  "access": {
    // Local dev: simulates a signed-in user via ctx.access so the API gate
    // passes. Comment this block to simulate Access not being enabled (403).
    // Fully restarting the dev server is required for changes to take effect.
    "dev": {
      "aud": "email-client",
      "identity": { "email": "owner@example.com" },
    },
  },
}
