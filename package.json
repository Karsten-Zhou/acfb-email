{
  "name": "acfb-email",
  "private": true,
  "version": "0.1.0",
  "homepage": "https://github.com/Karsten-Zhou/acfb-email",
  "repository": {
    "type": "git",
    "url": "https://github.com/Karsten-Zhou/acfb-email.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "postinstall": "patch-package",
    "typecheck": "run-p -c typecheck:app typecheck:server typecheck:node typecheck:e2e",
    "typecheck:app": "vue-tsc --build --force tsconfig.app.json",
    "typecheck:server": "tsc --build --force tsconfig.server.json",
    "typecheck:node": "tsc --build --force tsconfig.node.json",
    "typecheck:e2e": "tsc --build --force tsconfig.e2e.json",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,vue}\" \"shared/**/*.ts\" \"server/**/*.ts\" \"docs/**/*.{md,ts}\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue}\" \"shared/**/*.ts\" \"server/**/*.ts\" \"docs/**/*.{md,ts}\" \"*.md\"",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate-types": "wrangler types server/worker-configuration.d.ts --env-interface GeneratedEnv --include-runtime=false",
    "deploy": "node scripts/deploy.ts",
    "changelog": "conventional-changelog -p conventionalcommits -i docs/changelog.md -s -r 0",
    "release": "commit-and-tag-version --infile docs/changelog.md",
    "release:dryrun": "commit-and-tag-version --infile docs/changelog.md --dry-run"
  },
  "dependencies": {
    "@fluentui/priority-overflow": "^9.4.3",
    "@formatjs/intl-localematcher": "^0.8.13",
    "@lucide/vue": "^1.37.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/vue-query": "^5.102.8",
    "@tiptap/extension-placeholder": "^3.30.5",
    "@tiptap/extension-text-style": "^3.30.5",
    "@tiptap/pm": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "@tiptap/vue-3": "^3.30.5",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.14",
    "hono": "^4.13.5",
    "imapflow": "^1.7.8",
    "jose": "^6.2.11",
    "mimetext": "^3.0.28",
    "postal-mime": "^3.0.0",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.10",
    "vue-router": "^5.3.0",
    "web-push": "^3.6.7",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.2",
    "@cloudflare/vitest-plugin": "^1.1.2",
    "@cloudflare/workers-types": "^5.20260829.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@types/node": "^24.13.3",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-vue": "~6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "commit-and-tag-version": "^13.1.2",
    "conventional-changelog-cli": "^5.0.0",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "lefthook": "^2.1.12",
    "npm-run-all2": "^9.0.3",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "~8.2.2",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.127.1"
  },
  "commit-and-tag-version": {
    "scripts": {
      "posttag": "git add package.json docs/changelog.md"
    }
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true,
    "workerd@1.20260903.1": true,
    "lefthook@2.1.12": true,
    "vue-demi@0.14.10": true,
    "core-js-pure@3.50.0": true
  }
}
