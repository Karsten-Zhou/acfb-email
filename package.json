{
  "name": "a-cloudflare-based-email-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build --force tsconfig.app.json && tsc --build --force tsconfig.server.json",
    "typecheck:app": "vue-tsc --build --force tsconfig.app.json",
    "typecheck:server": "tsc --build --force tsconfig.server.json",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,vue}\" \"shared/**/*.ts\" \"server/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue}\" \"shared/**/*.ts\" \"server/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "@formatjs/intl-localematcher": "^0.8.13",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/extension-placeholder": "^3.30.3",
    "@tiptap/extension-text-style": "^3.30.3",
    "@tiptap/pm": "^3.30.3",
    "@tiptap/starter-kit": "^3.30.3",
    "@tiptap/vue-3": "^3.30.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.14",
    "hono": "^4.13.3",
    "lucide-vue-next": "^1.0.0",
    "mimetext": "^3.0.28",
    "postal-mime": "^3.0.0",
    "reka-ui": "^2.10.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.1",
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^5.20260821.1",
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.0",
    "@vitejs/plugin-vue": "~5.2.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.6",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.67.0",
    "vite": "~8.2.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.125.0"
  }
}
