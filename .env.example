# ============================================================
# Copy this file to `.env` for LOCAL development and fill in
# real values. `.env` is git-ignored; NEVER commit real values.
#
# Production secrets are set via `wrangler secret put <NAME>`.
# ============================================================

# 32-byte hex key used to encrypt stored email credentials (AES-GCM).
# Generate:
#   bun -e "console.log([...crypto.getRandomValues(new Uint8Array(32))].map(b=>b.toString(16).padStart(2,'0')).join(''))"
CREDENTIAL_ENCRYPTION_KEY=64_hex_characters

# --- Gmail (Google Cloud OAuth) — optional. Leave empty to skip Gmail.
# The OAuth token enables IMAP/SMTP access (XOAUTH2). ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Outlook (Microsoft Entra OAuth) — optional. Leave empty to skip Outlook.
# The OAuth token enables IMAP/SMTP access (XOAUTH2). ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
