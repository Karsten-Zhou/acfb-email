// Frontend (Vue SPA) project: runs in the browser.
{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["./shared/*"]
    },
    "types": []
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "shared/**/*.ts"]
}