// Integration tests: run inside the Workers runtime via the Cloudflare Vitest
// plugin. `cloudflare:test` / `cloudflare:workers` are runtime-only modules; their
// types come from `@cloudflare/vitest-plugin/types` + `@cloudflare/workers-types`
// (Cloudflare's documented setup).
{
  "extends": "@vue/tsconfig/tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "WebWorker"],
    "types": ["@cloudflare/vitest-plugin/types", "@cloudflare/workers-types"]
  },
  "include": ["e2e/**/*.ts", "test/**/*.ts"]
}
